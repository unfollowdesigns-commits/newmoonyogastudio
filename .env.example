# Supabase → Project Settings → API. Leave empty to run the on-device demo.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Set to "on" only after enabling Google in Supabase → Authentication → Providers.
NEXT_PUBLIC_AUTH_GOOGLE=
# Which studio this deployment is for: the folder name in clients/ (newmoon, …).
NEXT_PUBLIC_CLIENT=newmoon
